# App
APP_URL=http://localhost:3000
SESSION_COOKIE_SECURE=false
# Google Cloud OAuth 2.0 Web client. Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Database. Local zero-install: pglite://./.routerchat/pgdata
# Production: postgresql://postgres:postgres@localhost:5432/routerchat
DATABASE_URL=pglite://./.routerchat/pgdata
DATABASE_SSL=false

# OpenAI-compatible provider (server-only; never NEXT_PUBLIC_*)
ROUTER9_BASE_URL=https://api.example.com/v1
ROUTER9_API_KEY=replace-with-provider-api-key
# Explicit allowlist, comma-separated. First available ID becomes the default model.
ROUTER9_ALLOWED_MODELS=provider/model-id
# Batas tanpa token baru; timer diulang setiap potongan jawaban.
ROUTER9_TIMEOUT_MS=45000
